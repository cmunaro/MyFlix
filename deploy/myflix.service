[Unit]
Description=MyFlix household media library
After=network.target
RequiresMountsFor=/srv/media/library

[Service]
Type=simple
User=myflix
Group=media
WorkingDirectory=/opt/myflix/current
EnvironmentFile=/etc/myflix.env
Environment=MYFLIX_DATA=/var/lib/myflix
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/myflix/current/.venv/bin/python -m myflix
Restart=on-failure
RestartSec=5
StateDirectory=myflix
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/media/library
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
